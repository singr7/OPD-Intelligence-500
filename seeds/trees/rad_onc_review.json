    "te": "రేడియేషన్ ఆంకాలజీ — చికిత్స సమయంలో సమీక్ష"
  },
  "root": "rt.site",
  "nodes": [
    {
      "id": "rt.site",
      "type": "single",
      "text": {
        "en": "Which part of your body is getting the radiation?",
        "hi": "आपके शरीर के किस हिस्से पर सिकाई हो रही है?",
        "mr": "तुमच्या शरीराच्या कोणत्या भागावर शेक दिला जातोय?",
        "te": "మీ శరీరంలో ఏ భాగానికి రేడియేషన్ ఇస్తున్నారు?"
      },
      "options": [
        {
          "id": "head_neck",
          "icon": "head",
          "text": {
            "en": "Head or neck",
            "hi": "सिर या गला",
            "mr": "डोकं किंवा मान",
            "te": "తల లేదా మెడ"
          }
        },
        {
          "id": "chest",
          "icon": "chest",
          "text": {
            "en": "Chest",
            "hi": "छाती",
            "mr": "छाती",
            "te": "ఛాతీ"
          }
        },
        {
          "id": "breast",
          "icon": "breast",
          "text": {
            "en": "Breast",
            "hi": "स्तन",
            "mr": "स्तन",
            "te": "రొమ్ము"
          }
        },
        {
          "id": "pelvis",
          "icon": "pelvis",
          "text": {
            "en": "Lower stomach or hip",
            "hi": "पेट का निचला हिस्सा या कूल्हा",
            "mr": "पोटाचा खालचा भाग किंवा कंबर",
            "te": "కడుపు కింది భాగం లేదా తుంటి"
          }
        },
        {
          "id": "other",
          "icon": "body",
          "text": {
            "en": "Somewhere else",
            "hi": "कोई और जगह",
            "mr": "दुसरीकडे कुठेतरी",
            "te": "మరెక్కడో"
          }
        }
      ],
      "next": {
        "head_neck": "rt.hn.swallow",
        "chest": "rt.chest.cough",
        "breast": "rt.skin",
        "pelvis": "rt.pelvis.urinary",
        "other": "rt.skin",
        "default": "rt.skin"
      },
      "adaptive_hints": "Patients say 'sikai' or 'raid' for radiation. The site decides which questions follow, so do not guess it — if unsure, ask which part the machine points at."
    },
    {
      "id": "rt.hn.swallow",
      "type": "single",
      "text": {
        "en": "How is your swallowing?",
        "hi": "आपको निगलने में कैसा लग रहा है?",
        "mr": "तुम्हाला गिळताना कसं वाटतंय?",
        "te": "మీకు మింగడం ఎలా ఉంది?"
      },
      "options": [
        {
          "id": "no_trouble",
          "icon": "ok",
          "text": {
            "en": "No trouble",
            "hi": "कोई दिक्कत नहीं",
            "mr": "काही त्रास नाही",
            "te": "ఇబ్బంది లేదు"
          }
        },
        {
          "id": "solids_hard",
          "icon": "food",
          "text": {
            "en": "Solid food is hard",
            "hi": "ठोस खाना मुश्किल है",
            "mr": "घन अन्न खाणं कठीण आहे",
            "te": "ఘనాహారం కష్టంగా ఉంది"
          }
        },
        {
          "id": "liquids_only",
          "icon": "water",
          "text": {
            "en": "Only liquids go down",
            "hi": "सिर्फ़ तरल ही जाता है",
            "mr": "फक्त द्रव पदार्थ घशाखाली उतरतात",
            "te": "ద్రవాలు మాత్రమే లోపలికి వెళ్తాయి"
          }
        },
        {
          "id": "nothing",
          "icon": "alert",
          "text": {
            "en": "Nothing goes down",
            "hi": "कुछ भी नहीं जाता",
            "mr": "काहीच घशाखाली उतरत नाही",
            "te": "ఏదీ లోపలికి వెళ్లడం లేదు"
          },
          "flag": true
        }
      ],
      "next": {
        "default": "rt.hn.mouth"
      },
      "red_flag": {
        "id": "rt.hn.no_swallow",
        "severity": "urgent",
        "label": {
          "en": "Unable to swallow anything",
          "hi": "कुछ भी निगल नहीं पा रहे",
          "mr": "काहीही गिळता येत नाही",
          "te": "ఏదీ మింగలేకపోవడం"
        },
        "instruction": {
          "en": "Please tell a nurse now — you may need fluids before you see the doctor.",
          "hi": "कृपया अभी नर्स को बताएं — डॉक्टर से मिलने से पहले आपको ड्रिप की ज़रूरत हो सकती है।",
          "mr": "कृपया आत्ताच नर्सला सांगा — डॉक्टरांना भेटण्यापूर्वी तुम्हाला सलाईनची गरज लागू शकते.",
          "te": "దయచేసి ఇప్పుడే నర్సుకు చెప్పండి — డాక్టర్‌ను కలిసే ముందు మీకు సెలైన్ అవసరం కావచ్చు."
        }
      }
