# Copy to .env for local dev. Never commit real secrets.
# --- Core ---
ENV=local
LOG_LEVEL=info
ENVIRONMENT_ID=local
ENVIRONMENT_NAME=Local development
API_CONTRACT_VERSION=2026-07-28
RELEASE_SHA=development

# --- Postgres ---
# DATABASE_URL is the in-cluster address (compose service name, container port).
# From the host, Postgres is published on 5433 — a native Postgres owns 5432 on
# the dev machine. Host-side tools take their own URL:
#   make migrate / make seed   pass it for you
#   pytest                     TEST_DATABASE_URL, default .../localhost:5433/opd_test
#   alembic by hand            ALEMBIC_DATABASE_URL=postgresql+asyncpg://opd:opd_local_dev@localhost:5433/opd
POSTGRES_USER=opd
POSTGRES_PASSWORD=opd_local_dev
POSTGRES_DB=opd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://opd:opd_local_dev@postgres:5432/opd

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth (S2) ---
# Local default is fine here; the app refuses to boot with ENV!=local unless this
# is replaced with a real secret of >=32 chars (see app/config.py).
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# --- Provider credential store (S-GL.1, doc 12 §7) ---
# Encrypts the vendor credentials an admin enters in the console's Channels tab.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Left empty, a key is derived from JWT_SECRET so the feature works on a box that
# has not been redeployed. That works, and it couples the two secrets: rotating
# JWT_SECRET then makes every stored credential unreadable (honestly — each row
# records which key wrote it, and the console says so — but they must be entered
# again). SET THIS ON THE BOX BEFORE ENTERING REAL META OR EXOTEL CREDENTIALS.
SECRETS_KEY=

# --- OTP (S2) ---
# Returns the OTP in the API response so local login doesn't need the logs.
# Refused outside ENV=local — it would hand every account to any caller.
OTP_DEBUG_ECHO=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- Web ---
# The browser talks to the api at its PUBLISHED host port. On a box where the api
# is not on 8000 (see API_HOST_PORT below), set this to match, e.g.
# http://localhost:18080 (testing on the box) or http://<box-ip>:18080 (over LAN,
# which then needs HTTPS for the kiosk mic). Baked into the bundle at build time.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Kiosk server-STT (V-OSS, doc 08): 1 = the chief-complaint mic records the clip and
# posts it to /kiosk/stt (local Whisper on the box — audio stays on-premises). Unset/0
# = the browser's Web Speech (Chrome ships audio to a cloud recogniser). Build-time.
NEXT_PUBLIC_KIOSK_SERVER_STT=0
# Kiosk server-TTS (V-OSS, doc 10 §6): 1 = the read-aloud posts text to /kiosk/tts
# (Voicebox's cloned Dhara voice on the box — on-premises, one branded voice) and
# plays the clip. Unset/0 = the browser's SpeechSynthesis. Build-time.
NEXT_PUBLIC_KIOSK_SERVER_TTS=0
# Adaptive intake (S-ADAPT.1, doc 11): 1 = a tap node also offers "answer by voice"
# — the spoken answer is mapped onto the node's own options by the on-box answer
# interpreter, with one clarifying follow-up before falling back to taps. Needs
# server-STT on. Unset/0 = every node is pure taps (today's flow). Build-time.
# Pair with the backend INTAKE_ADAPTIVE=1 (and a real, non-fake LLM_PROVIDER).
NEXT_PUBLIC_KIOSK_ADAPTIVE=0

# Adaptive intake backend gate (doc 11 §2). On, with a real LLM_PROVIDER, a kiosk
# answer that arrives as spoken text (value=null + raw_text) runs the interpreter.
# Off (default) or with LLM_PROVIDER=fake ⇒ the kiosk stays on deterministic taps.
INTAKE_ADAPTIVE=0

# --- Host ports (docker-compose) ---------------------------------------------
# Only the *host* side of each mapping; in-cluster ports never change. Defaults
# match the dev machine. On a box that already runs nginx (80/443) or has 8000/
# 3000/5432 taken, uncomment the "busy box" values below (all shifted into 18xxx/
# 15xxx) and set NEXT_PUBLIC_API_BASE to match API_HOST_PORT.
#   POSTGRES_HOST_PORT=15432
#   REDIS_HOST_PORT=16379
#   API_HOST_PORT=18080
#   WEB_HOST_PORT=13000
#   VOICE_GW_HOST_PORT=18090
#   GRAFANA_HOST_PORT=13001
#   LOKI_HOST_PORT=13100
#   KUMA_HOST_PORT=13002
#   CADDY_HTTP_PORT=18081     # only if you run caddy; nginx keeps 80/443
#   CADDY_HTTPS_PORT=18443

# =============================================================================
# Provider layer (S3) — doc 02 §9
#
# `fake` is the deterministic in-process impl: no network, no cost, no vendor
# account. Every one of these is a config-only swap — change the value, restart,
# done (app/providers/registry.py). Outside ENV=local the app REFUSES TO BOOT on
# any `fake`: a fake SMS is an OTP that never arrives, and a fake LLM is an
# intake that answers itself.
# =============================================================================

# --- Which vendor answers each interface ---
SMS_PROVIDER=fake             # fake | msg91 | exotel
LLM_PROVIDER=fake             # fake | gemini | openai | sarvam | local_vllm
STT_PROVIDER=fake             # fake | openai | sarvam | google | local_whisper
TTS_PROVIDER=fake             # fake | openai | sarvam | google | local_tts | voicebox
REALTIME_PROVIDER=fake        # fake | gemini-live (S5/S14) | local-pipecat (S-OSS.2, needs GPU)
MESSAGING_PROVIDER=fake       # fake | meta
TELEPHONY_PROVIDER=fake       # fake | exotel

# Second choice per doc 02 §2's chains. Empty = no fallback; the tier ladder
# handles the outage instead.
LLM_FALLBACK_PROVIDER=        # openai
STT_FALLBACK_PROVIDER=        # google
TTS_FALLBACK_PROVIDER=        # google
KIOSK_VOICE_PROFILE=local_oss # local_oss | openai_cloud | sarvam_cloud
KIOSK_LOCAL_TTS_PROVIDER=local_tts # local_tts | voicebox

# --- Gemini / OpenAI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Sarvam (Indic STT/TTS, telephony-tuned) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-30b
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_VOICE=anushka

# --- Google (STT/TTS fallback) ---
GOOGLE_API_KEY=
GOOGLE_TTS_VOICE=

# --- V-OSS: local open-source voice tier on the GPU box (doc 08) ---
# A base URL is all a local provider needs to count as "configured" — no key,
# unlike a cloud vendor. Reach the box over the WireGuard tunnel (doc 08 §4).
# Blank = not deployed; selecting a local provider without its URL reports
# unconfigured on /providers/health and fails the call over to the next tier.
LOCAL_VLLM_BASE_URL=          # e.g. http://10.8.0.2:8000/v1
LOCAL_VLLM_MODEL=qwen3-8b-awq
LOCAL_VLLM_API_KEY=           # only if a gateway fronts vLLM; usually blank
LOCAL_STT_URL=               # e.g. http://10.8.0.2:8010
LOCAL_STT_MODEL=whisper-large-v3-turbo
LOCAL_TTS_URL=               # Kokoro container: http://opd-tts:8000 (deploy/tts-kokoro)
LOCAL_TTS_MODEL=             # bake-off winner (S-OSS.1); blank uses adapter default
LOCAL_TTS_VOICE=             # blank = per-language default (hf_alpha/af_heart); or a Kokoro id
# --- Voicebox (reserved: the branded cloned "Dhara" voice, later iteration) ---
VOICEBOX_URL=                # Voicebox REST host for batch V3-pack generation
VOICEBOX_VOICE=dhara_hi_v1
# Per-channel tier ladder + MAX_OSS_SESSIONS live in config/tiers.yaml, not here.

# --- SMS: MSG91 ---
# The DLT template must declare variables named `otp` and `minutes` — that
# naming is a contract with the vendor account (see app/auth/otp.py). MSG91 Flow
# sends the template id + variables and renders on their side; our body is not
# transmitted, so a missing template id is a hard error, not a fallback.
MSG91_KEY=
MSG91_SENDER_ID=OPDALW
MSG91_TEMPLATE_IDS={"otp_login": ""}

# --- Exotel: telephony always; SMS only if it wins the SMS decision ---
# Note: picking Exotel for SMS too means one vendor outage takes down SMS *and*
# the phone intake channel together. MSG91 keeps those failure domains apart.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_SMS_SENDER_ID=OPDALW
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_IDS={"otp_login": ""}
# The Voicebot applet Exotel runs when an outbound campaign call is answered — it
# opens the websocket to voice-gw (S14). Configured in the Exotel console.
EXOTEL_APPLET_URL=
# Where Exotel posts a call's final state + duration: the only moment per-call
# telephony cost is knowable (S15). The token is a shared secret on the query
# string; with the campaign enabled, booting without it is refused.
EXOTEL_STATUS_CALLBACK_URL=
EXOTEL_WEBHOOK_TOKEN=
# Where an AI-receptionist handoff transfers the caller (doc 03 §2). Empty means
# the whisper line is logged and the caller stays with the assistant.
COORDINATOR_PHONE=

# --- Outbound D-1 intake campaign (S15, doc 01 §4.2) ---
# OFF by default, deliberately: a box that boots with real Exotel credentials must
# not start ringing patients because beat came up. `make campaign-dryrun` prints
# tomorrow's call list without dialling anyone, whatever this is set to.
CAMPAIGN_ENABLED=false
# Hospital-local hour the campaign launches (evening — patients are home and the
# call is about tomorrow).
CAMPAIGN_HOUR=18
# How far ahead the nightly job materialises bookable slots from the templates.
SLOT_GENERATION_HORIZON_DAYS=60

# --- Post-treatment check-ins (S17, doc 03 §9) ---
# ON by default, unlike the campaign: a check-in only ever goes out on a plan a
# doctor approved one tap at a time, so there is no "it started messaging by
# itself" failure to guard against. Turn it OFF on a box being restored or
# replayed, where the approvals are real and the calendar is not.
CHECKINS_ENABLED=true
# Hospital-local hour a check-in is sent. Mid-morning: late enough that a patient
# recovering from chemotherapy has woken, early enough that a red answer reaches
# a nurse who is still on shift.
CHECKIN_SEND_HOUR=10
# doc 03 §9's quiet hours, hospital-local. Nothing is delivered inside them, on
# any channel. Enforced in `app.checkins.window`, not by the beat schedule — beat
# firing at 22:00 on a box in the wrong timezone must not be the only thing
# between a patient and a 3am phone call.
CHECKIN_QUIET_START_HOUR=21
CHECKIN_QUIET_END_HOUR=8
# The Voicebot applet Exotel runs for the VOICE rung of the check-in delivery
# ladder. Empty on purpose: the voice-gw handler behind it does not exist yet, so
# the rung records "not configured" and the ladder falls through to SMS rather
# than dialling a patient into an applet that answers with silence.
EXOTEL_CHECKIN_APPLET_URL=

# --- Meta WhatsApp Cloud API (S12, doc 03 §1d) ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# Webhook auth. META_VERIFY_TOKEN is the shared secret Meta echoes on the GET
# subscription handshake; META_APP_SECRET signs every inbound POST, which the
# webhook verifies (X-Hub-Signature-256). Both empty on a fake stack — signature
# checking is skipped only when no secret is set.
META_VERIFY_TOKEN=
META_APP_SECRET=
# Attach a synthesized voice note to each WhatsApp reply (the "WhatsApp calling"
# value for a patient who cannot read). Off by default: it spends a TTS call per
# turn, and the text reply is always sent regardless.
WHATSAPP_VOICE_NOTES=false

# --- Cost guard (doc 02 §8) ---
# Daily spend cap in rupees per channel. A channel with no entry is UNCAPPED —
# deliberate, so a missing key never silently throttles a channel nobody
# budgeted for. Breach downgrades the tier (V1->V2->V3); it never blocks a call
# or turns a patient away.
COST_GUARD_ENABLED=true
DAILY_BUDGET_INR={"phone": "2000", "whatsapp": "500", "kiosk": "500", "app": "200"}
COST_GUARD_ALERT_FRACTION=0.8
COST_GUARD_OVERRIDE_TTL_SECONDS=900
# The OPD's day is IST: a UTC budget rollover would reset the cap at 05:30 IST,
# in the middle of the morning rush.
TIMEZONE=Asia/Kolkata

# --- Offline kiosk token blocks (S7, doc 01 §5) ------------------------------
# The token line is split so an offline kiosk and the server can both issue
# during an outage without colliding: online tokens stay below the base, offline
# blocks are carved at/above it. Nothing may cross the base.
KIOSK_OFFLINE_TOKEN_BASE=500
KIOSK_OFFLINE_BLOCK_SIZE=50

# --- Queue (S8, doc 03 §6) --------------------------------------------------
# Seed for the wait-time estimator before a department has finished any consults
# today; after that it uses its own observed mean. Downtime is an in-memory flag
# (coordinator toggle), not configured here.
QUEUE_DEFAULT_CONSULT_MINUTES=6
