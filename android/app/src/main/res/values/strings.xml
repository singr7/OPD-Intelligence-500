<?xml version="1.0" encoding="utf-8"?>
<!--
  Every patient-facing string, in all four pilot languages (doc 07 §4's quality
  gate). English is the default folder; hi/mr/te are complete siblings. mr and te
  are owed the same native + clinical review as the rest of the tree bank (S21).

  Tone follows doc 04 law 7: second person, warm, plain. No clinical register,
  no "please contact your healthcare provider".
-->
<resources>
    <string name="app_name">My Cancer Care</string>

    <!-- onboarding (three spoken screens, doc 04 §3) -->
    <string name="onboard_1_title">Your papers, always with you</string>
    <string name="onboard_1_body">Every prescription and every summary is kept here. It opens even with no network.</string>
    <string name="onboard_2_title">Answer the questions from home</string>
    <string name="onboard_2_body">Do tomorrow\'s questions tonight, by speaking. On arrival you get your token faster.</string>
    <string name="onboard_3_title">We will remind you</string>
    <string name="onboard_3_body">Your phone will remind you about each medicine, and tell your family if a dose is missed.</string>
    <string name="onboard_next">Next</string>
    <string name="onboard_start">Let\'s begin</string>
    <string name="onboard_replay">Listen again</string>

